{
	"$schema": "https://json.schemastore.org/web-manifest-combined.json",
	"name": "Testify — Test Engine & PDF Exam Simulator",
	"short_name": "Testify",
	"description": "Convert any test or assignment PDF into an interactive, timed exam. Works 100% offline with local IndexedDB storage.",
	"start_url": "/",
	"scope": "/",
	"id": "/",
	"display": "standalone",
	"display_override": ["standalone", "window-controls-overlay", "minimal-ui"],
	"orientation": "any",
	"theme_color": "#121217",
	"background_color": "#121217",
	"lang": "en",
	"dir": "ltr",
	"categories": ["education", "productivity", "utilities"],
	"icons": [
		{
			"src": "/icons/icon-48.png",
			"sizes": "48x48",
			"type": "image/png"
		},
		{
			"src": "/icons/icon-72.png",
			"sizes": "72x72",
			"type": "image/png"
		},
		{
			"src": "/icons/icon-96.png",
			"sizes": "96x96",
			"type": "image/png"
		},
		{
			"src": "/icons/icon-144.png",
			"sizes": "144x144",
			"type": "image/png"
		},
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512-maskable.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/icons/icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		}
	],
	"shortcuts": [
		{
			"name": "Dashboard",
			"short_name": "Dashboard",
			"description": "View and manage all available exams",
			"url": "/",
			"icons": [
				{
					"src": "/icons/icon-96.png",
					"sizes": "96x96"
				}
			]
		}
	]
}
